@model Stock.Web.Models.UsuarioViewModel
@{
    ViewData["Title"] = $"Baja del usuario {Model.NombreUsuario}";
}

<h1>Dar de baja el usuario @Model.NombreUsuario</h1>

@* RF-005a: si es el último usuario administrador, la baja se rechaza con 409 para que el sistema
   no quede sin quien administre usuarios y perfiles. *@
@if (!string.IsNullOrWhiteSpace(Model.MensajeDeRechazo))
{
    <div class="alert alert-warning" role="alert">@Model.MensajeDeRechazo</div>
}

<dl class="row">
    <dt class="col-sm-3">Nombre de usuario</dt>
    <dd class="col-sm-9">@Model.NombreUsuario</dd>

    <dt class="col-sm-3">Nombre completo</dt>
    <dd class="col-sm-9">@Model.NombreCompleto</dd>
</dl>

<form method="post" asp-action="Delete" asp-route-id="@Model.UsuarioId">
    <button type="submit" class="btn btn-danger">Confirmar baja</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
