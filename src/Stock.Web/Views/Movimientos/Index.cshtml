@model List<Stock.Web.Models.MovimientoViewModel>
@{
    ViewData["Title"] = "Movimientos";
}

<h1>Movimientos</h1>

<p><a class="btn btn-primary" asp-action="Create">Nuevo movimiento</a></p>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">Todavía no hay movimientos registrados.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Número</th>
                <th>Tipo</th>
                <th>Fecha</th>
                <th class="text-end">Líneas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movimiento in Model)
            {
                <tr>
                    <td>@movimiento.Numero</td>
                    <td>@movimiento.Tipo</td>
                    <td>@movimiento.Fecha.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@movimiento.Detalle.Count</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@movimiento.Numero">Modificar</a>
                        <a asp-action="Delete" asp-route-id="@movimiento.Numero">Baja</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
