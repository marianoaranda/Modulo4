@model Stock.Web.Models.MovimientoViewModel
@{
    ViewData["Title"] = $"Baja del movimiento {Model.Numero}";
}

<h1>Dar de baja el movimiento @Model.Numero</h1>

@* La baja arrastra encabezado y detalle (RF-021), y puede rechazarse si dejaría el stock de algún
   artículo por debajo de 0 (RF-024a) — típicamente una compra ya consumida por ventas
   posteriores. *@
@if (!string.IsNullOrWhiteSpace(Model.MensajeDeRechazo))
{
    <div class="alert alert-warning" role="alert">@Model.MensajeDeRechazo</div>
}

<dl class="row">
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.Tipo</dd>

    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-2">Líneas</dt>
    <dd class="col-sm-10">@Model.Detalle.Count</dd>
</dl>

<form method="post" asp-action="Delete" asp-route-id="@Model.Numero">
    <button type="submit" class="btn btn-danger">Confirmar baja</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
