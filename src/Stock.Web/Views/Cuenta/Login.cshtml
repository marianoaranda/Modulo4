@model Stock.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Iniciar sesión</h1>

        @* RF-011: el mismo mensaje ante usuario inexistente y contraseña incorrecta. La pantalla
           lo muestra tal como lo redacta la API, sin agregar detalle. *@
        @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
        {
            <div class="alert alert-danger" role="alert">@Model.Mensaje</div>
        }

        <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div class="mb-3">
                <label class="form-label" asp-for="Usuario"></label>
                <input class="form-control" asp-for="Usuario" autocomplete="username" autofocus />
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" type="password"
                       autocomplete="current-password" />
            </div>

            <button type="submit" class="btn btn-primary">Ingresar</button>
        </form>
    </div>
</div>
