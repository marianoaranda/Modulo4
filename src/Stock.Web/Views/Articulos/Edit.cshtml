@model Stock.Web.Models.ArticuloViewModel
@{
    ViewData["Title"] = $"Artículo {Model.Codigo}";
}

<h1>Modificar artículo</h1>

<form method="post" asp-action="Edit" asp-route-id="@Model.ArticuloId">
    <partial name="_Formulario" model="Model" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Grabar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
