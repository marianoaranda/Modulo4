@model Stock.Web.Models.ArticuloViewModel
@{
    ViewData["Title"] = $"Baja del artículo {Model.Codigo}";
}

<h1>Dar de baja el artículo @Model.Codigo</h1>

@* RF-014a: la baja se rechaza si el artículo tiene movimientos asociados, para que el histórico
   y el Stock Actual derivado se preserven íntegros. *@
@if (!string.IsNullOrWhiteSpace(Model.MensajeDeRechazo))
{
    <div class="alert alert-warning" role="alert">@Model.MensajeDeRechazo</div>
}

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Codigo</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Precio de Venta</dt>
    <dd class="col-sm-9">@Model.PrecioVenta.ToString("N2")</dd>
</dl>

<form method="post" asp-action="Delete" asp-route-id="@Model.ArticuloId">
    <button type="submit" class="btn btn-danger">Confirmar baja</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
