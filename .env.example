# Plantilla de secretos locales (Principio IV).
#
#   cp .env.example .env
#
# y completar los tres valores. El archivo `.env` está ignorado por .gitignore y NO se commitea;
# este archivo sí se commitea, pero sólo con placeholders — nunca con valores reales.

# Contraseña del usuario `sa` de SQL Server.
# Debe cumplir la política del motor: 8+ caracteres con mayúsculas, minúsculas y dígitos.
SA_PASSWORD=<reemplazar-por-una-contrasena-fuerte>

# Clave de firma HS256 del JWT (R-04). Mínimo 32 caracteres.
# Generar con: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SIGNING_KEY=<reemplazar-por-una-clave-aleatoria-de-32-o-mas-caracteres>

# Contraseña del usuario `admin` sembrado en el primer arranque.
# Debe cumplir RF-009: mínimo 8 caracteres, con al menos una letra y un dígito.
SEED_ADMIN_PASSWORD=<reemplazar-por-la-contrasena-inicial-del-admin>
